# ==============================================================================
# VARIABLES DE ENTORNO - ACADEMIA DEPORTIVA
# ==============================================================================

# Entorno: production o development
FLASK_ENV=production
FLASK_DEBUG=false

# Clave secreta de sesión (si no se define, se genera automáticamente una local)
SECRET_KEY=cambiar_por_una_cadena_secreta_segura_en_produccion_64_caracteres

# ------------------------------------------------------------------------------
# CONEXIÓN A BASE DE DATOS (DATABASE_URL)
# ------------------------------------------------------------------------------
# 1. Opción Local SQLite (por defecto si se deja vacío o no se especifica):
# DATABASE_URL=sqlite:///instance/academia.db

# 2. Opción PostgreSQL Local (Docker Compose o instalación nativa):
# DATABASE_URL=postgresql://academia_user:academia_password@localhost:5432/academia_futbol

# 3. Opción PostgreSQL en la Nube (Render, Railway, Supabase, Neon):
# Nota: La app convierte automáticamente prefijos 'postgres://' a 'postgresql://'
# DATABASE_URL=postgresql://usuario:contrasena@ep-xyz.us-east-1.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL=postgresql://postgres.xxx:clave@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# ------------------------------------------------------------------------------
# AJUSTES DE RENDIMIENTO POSTGRESQL (OPCIONALES)
# ------------------------------------------------------------------------------
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_CONNECT_TIMEOUT=10
# DB_POOL_RECYCLE=300

# ------------------------------------------------------------------------------
# PUERTO Y HOST (Detectado automáticamente en la nube)
# ------------------------------------------------------------------------------
# PORT=5000
# HOST=0.0.0.0
